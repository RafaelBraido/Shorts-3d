# Todas as IAs abaixo têm plano GRÁTIS (sem cartão). Configure pelo menos a primeira.

# 1) Gemini (principal; aceita imagens e textos grandes) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) Groq (reserva rápida, só para textos curtos) -> https://console.groq.com/keys
GROQ_API_KEY=

# 3) OpenRouter (reserva, modelos grátis) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcionais
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# OPENROUTER_MODELS=openrouter/free

# Só para desenvolvimento local: respostas de mentira, sem usar a IA
# STUDY_IT_MOCK=1
