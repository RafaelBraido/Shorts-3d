# Na Vercel não precisa de nenhuma chave: o AI Gateway autentica sozinho.
# Só para rodar localmente: crie uma chave em Vercel → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# Opcional
# STUDY_IT_MODEL=anthropic/claude-haiku-5-5
# STUDY_IT_EFFORT=medium      # none | low | medium | high

# Só para desenvolvimento local: respostas de mentira, sem gastar nada
# STUDY_IT_MOCK=1
