; Fish It - projeto Godot 4
config_version=5

[application]

config/name="Fish It Prototype"
config/description="Fish It - jogo 3D em primeira pessoa de pesca e tiro numa ilha tropical."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/audio_manager.gd"
Net="*res://scripts/autoload/network.gd"
Story="*res://scripts/autoload/story.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

